# Скопировать в .env и заполнить.
DATABASE_URL=postgresql://localhost/grosterhit_dev

# Внешний mailer-service (микросервис отправки). Задан → письма идут через него.
MAILER_SERVICE_URL=
MAILER_SERVICE_TOKEN=

# SMTP-relay ESP (Unisender/Sendsay/Mailgun/…). Пустой SMTP_HOST → dev-лог вместо отправки.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=noreply@mail.groster.me
MAIL_FROM_NAME=groster.me

# 1С HTTP-сервис (pull). Пусто → используются push-фиды /feeds/* (дев/тест).
ONEC_BASE_URL=
ONEC_TOKEN=
ONEC_SYNC_TICK_SEC=86400

# Интервалы воркеров (сек)
CART_TICK_SEC=30
POSTSALE_TICK_SEC=300
ATTRIBUTION_TICK_SEC=300
BEST_OFFER_TICK_SEC=3600

# Параметры сценариев (ТЗ) — вынесены в конфиг, правятся из админки.
BEST_OFFER_INTERVAL_DAYS=30
BEST_OFFER_AFTER_PURCHASE_DAYS=20
POSTSALE_DELAY_DAYS=7
CART_COOLDOWN_HOURS=72
CART_DEPART_TIMEOUT_SEC=180
CART_GRACE_SEC=90
ATTRIBUTION_WINDOW_HOURS=72

# CORS для триггер-сниппета (cart-ping кросс-доменно). Пусто → "*" (дев).
CORS_ORIGINS=https://groster.me,https://www.groster.me

# Публичный адрес сервиса (домен API): ссылки в письмах (отписка), embed сниппета.
PUBLIC_BASE_URL=https://groster.skypath.fun
