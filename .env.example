# Скопировать в .env и заполнить.
DATABASE_URL=postgresql://localhost/grosterhit_dev

# Внешний mailer-service (микросервис отправки). Задан → письма идут через него.
# Для локального sendmail на хосте оставьте пустым и задайте MAIL_TRANSPORT=sendmail.
MAILER_SERVICE_URL=
MAILER_SERVICE_TOKEN=

# Транспорт: sendmail | smtp | пусто (авто: sendmail если бинарь есть, иначе SMTP/лог).
# Без ESP на хосте: MAIL_TRANSPORT=sendmail + пустой MAILER_SERVICE_URL (см. deploy/MAIL_DNS.md).
# В Docker compose письма всегда идут в mailer-service — SMTP/sendmail настраивайте там
# (админка → Настройки → Почта) или SMTP_* ниже (env_file подхватывает mailer).
MAIL_TRANSPORT=
SENDMAIL_PATH=/usr/sbin/sendmail

# SMTP: ESP или свой ящик (Яндекс/Mail.ru). Порт 465 → implicit SSL; 587 → STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@mail.groster.me
MAIL_FROM_NAME=groster.me

# 1С HTTP-сервис (pull). Пусто → используются push-фиды /feeds/* (дев/тест).
ONEC_BASE_URL=
ONEC_TOKEN=
ONEC_SYNC_TICK_SEC=86400

# Интервалы воркеров (сек)
CART_TICK_SEC=30
POSTSALE_TICK_SEC=300
ATTRIBUTION_TICK_SEC=300
BEST_OFFER_TICK_SEC=3600

# Параметры сценариев (ТЗ) — вынесены в конфиг, правятся из админки.
BEST_OFFER_INTERVAL_DAYS=30
BEST_OFFER_AFTER_PURCHASE_DAYS=20
POSTSALE_DELAY_DAYS=7
CART_COOLDOWN_HOURS=72
CART_DEPART_TIMEOUT_SEC=180
CART_GRACE_SEC=90
ATTRIBUTION_WINDOW_HOURS=72

# CORS для триггер-сниппета (cart-ping кросс-доменно). Пусто → "*" (дев).
CORS_ORIGINS=https://groster.me,https://www.groster.me

# Публичный адрес сервиса (домен API): ссылки в письмах (отписка), embed сниппета.
PUBLIC_BASE_URL=https://groster.skypath.fun

# Адрес магазина: куда ведут кнопки «в магазин» в письмах. Меняется независимо от домена
# сервиса — при переезде витрины правится только эта строка.
SHOP_URL=https://groster.me

# Авторизация админки. Пустой ADMIN_PASSWORD → вход в /admin отключён (дев / за NPM Basic Auth).
# Задайте пароль для собственной страницы входа /login. SESSION_SECRET пуст → подпись куки
# выводится из пароля (смена пароля разлогинивает всех). Задайте длинную случайную строку в проде.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Docker (docker-compose up) ---
# Хостовый порт для api (loopback, под SSH-туннель админки). Смените, если 8000 занят
# (напр. Portainer). Внутри сети compose api всегда 8000 — nginx/workers/mailer не трогать.
API_HOST_PORT=8000
# Пароль контейнерной БД. Обязателен: compose подставляет его в DATABASE_URL.
POSTGRES_PASSWORD=change-me
# В Docker DATABASE_URL и MAILER_SERVICE_URL задаёт compose (сервисы db/mailer по имени) —
# значения выше игнорируются в контейнерах.
# Один секрет для mailer'а: MAILER_SERVICE_TOKEN (app → mailer) compose прокидывает как
# API_TOKEN mailer'а. Оставьте пустым, чтобы отключить проверку токена.
MAILER_SERVICE_TOKEN=

# IP шлюза compose-моста (не docker0!). Mailer на host-network; api ходит сюда.
# Смотреть: ip -br a | grep '^br-'  → обычно 172.18.0.1
MAILER_HOST_IP=172.18.0.1
