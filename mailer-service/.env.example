# Подключение к провайдеру (SMTP-relay ESP). Пусто → dev-режим (лог, без реальной отправки).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=noreply@mail.groster.me
MAIL_FROM_NAME=groster.me

# Очередь и доставка
DB_PATH=outbox.db
RATE_PER_MIN=120
MAX_ATTEMPTS=5
RETRY_BASE_SEC=30

# Обратный вызов событий в основное приложение
CALLBACK_URL=http://127.0.0.1:8000/esp/webhook
CALLBACK_TOKEN=

# Токен для защиты API микросервиса (основное приложение шлёт его в Authorization)
API_TOKEN=
